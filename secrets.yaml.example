# Copy this file to secrets.yaml and fill in your credentials:
#   cp secrets.yaml.example secrets.yaml

# Wi-Fi network credentials
wifi_ssid: "your_wifi_ssid"
wifi_password: "your_wifi_password"
wifi_domain: ".local"

# ESPHome Over-The-Air (OTA) update password
ota_password: "your_ota_password"

# Fallback captive portal hotspot password (8-63 characters)
ap_password: "your_fallback_ap_password"

# Optional: Home Assistant API encryption key (32-byte base64 encoded)
api_encryption_key: "your_base64_api_encryption_key"

